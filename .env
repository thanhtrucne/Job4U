# Environment variables for TopCV Job Portal
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
# Async URL (used by FastAPI / SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/topcv_db

# Sync URL (used by crawler / psycopg2)
DATABASE_URL_SYNC=postgresql://postgres:123456@localhost:5432/topcv_db

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ── Admin credentials ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SECRET_KEY=change-this-secret-key-in-production-!!!

# ── Crawler settings ──────────────────────────────────────────────────────────
CRAWL_INTERVAL_MINUTES=30
CRAWLER_DELAY_SECONDS=2.0
MAX_RETRY=3

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=jobportaladmin
MINIO_SECRET_KEY=thanhtruc
MINIO_BUCKET=job-portal-documents
MINIO_SECURE=false

# Email chào mừng sau khi đăng ký 
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=thanhtruc74965@gmail.com
SMTP_PASSWORD=zqdt qbkw samj achx
SMTP_FROM_EMAIL=thanhtruc74965@gmail.com
SMTP_FROM_NAME=Job4U
SMTP_USE_TLS=true
